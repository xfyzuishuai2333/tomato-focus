{
  "manifest_version": 3,
  "name": "番茄专注 · Tomato Focus",
  "short_name": "番茄专注",
  "version": "1.0.0",
  "description": "简洁高效的番茄钟专注计时器，帮助你保持专注、追踪工作节奏。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "番茄专注",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "notifications"],
  "host_permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
